# clang-tidy for psychic-ui: a strict set. Fix what it reports by changing how the code is written,
# never with NOLINT. Every check below that is off says why.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-prefer-member-initializer,
  misc-*,
  -misc-no-recursion,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-uppercase-literal-suffix,
  -readability-redundant-member-init,
  -readability-implicit-bool-conversion
# Why those are off:
# - The cppcoreguidelines ones (avoid-magic-numbers, non-private-member-variables-in-classes,
#   narrowing-conversions, avoid-c-arrays, explicit-virtual-functions) are aliases of readability,
#   misc, bugprone and modernize checks that stay on: one report per warning, not two.
# - cppcoreguidelines-prefer-member-initializer wants the child parts a constructor creates (`_label = &add<Label>()`)
#   in its initializer list, which would add them in member declaration order, before the constructor's tag and
#   styles: they must be added in its body, in order (the overlay stays the window's last child; a dialog's and an
#   app shell's parts keep their order). Members set from constructor arguments still go in the initializer list.
# - bugprone-easily-swappable-parameters flags every (float x, float y).
# - misc-no-recursion flags walking a UI tree, which is recursive by nature.
# - portability-avoid-pragma-once: #pragma once works on every compiler the project targets.
# - The house style: no trailing return types, lowercase literal suffixes (1.0f), `std::vector<X> v{}`
#   member initializers (readability-redundant-member-init) and `if (ptr)` (implicit bool conversion).
HeaderFilterRegex: '.*'
# Only the project's own headers: not the submodules, the downloaded Catch2 or the Nix store.
ExcludeHeaderFilterRegex: '.*/(extlib|lib/psychic-color|_deps)/.*|^/nix/store/.*'
CheckOptions:
  readability-identifier-length.IgnoredVariableNames: '^(x|y|z|w|h|i|j|k|n|r|g|b|a|t|s|dx|dy|it|id|ok|os)$'
  readability-identifier-length.IgnoredParameterNames: '^(x|y|z|w|h|i|j|k|n|r|g|b|a|t|s|dx|dy|it|id|os)$'
  readability-identifier-length.IgnoredLoopCounterNames: '^[ijk_]$'
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
